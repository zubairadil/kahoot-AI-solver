{
  "manifest_version": 3,
  "name": "Kahoot AI Assistant",
  "version": "1.2",
  "description": "Extracts questions and sends them to a local AI assistant.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:11434/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}